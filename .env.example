# MarketIntelligence Configuration

# Apify API Token (required for web scraping)
# Get from: https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_token_here

# Anthropic API Key (required for Claude enrichment and scoring)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Kalibr API Key (multi-model orchestration)
# Get from: https://app.kalibr.com/settings/api-keys
KALIBR_API_KEY=your_kalibr_api_key_here

# Kalibr Tenant ID (your organization ID)
KALIBR_TENANT_ID=your_kalibr_tenant_id_here
